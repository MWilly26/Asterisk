# Model provider: "anthropic" for development/testing, "nvidia" for the final build.
CLAUSE_PROVIDER=anthropic

# Anthropic (used when CLAUSE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# NVIDIA (used when CLAUSE_PROVIDER=nvidia)
NVIDIA_API_KEY=

# Optional: self-hosted Nano NIM (e.g. a Brev GPU running the same model).
# Leave blank to use the hosted catalog endpoint. Parse stays on the hosted
# endpoint unless NVIDIA_PARSE_BASE_URL is also set. Set NVIDIA_NANO_MODEL only
# if the self-hosted NIM registers the model under a different name.
NVIDIA_BASE_URL=
NVIDIA_PARSE_BASE_URL=
NVIDIA_NANO_MODEL=
